# ─── Base de datos ────────────────────────────────────────────────────────────
# Railway provee esta variable automáticamente al añadir el addon PostgreSQL.
DATABASE_URL="postgresql://user:pass@host:5432/gestarcorp"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# OBLIGATORIO: cambiar a un string aleatorio largo y seguro.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_A_SECRETO_SEGURO"
JWT_EXPIRES_IN="7d"

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Railway asigna PORT automáticamente — no lo cambies manualmente.
NODE_ENV="production"

# URL pública de la app (Railway la muestra en el dashboard del servicio).
FRONTEND_URL="https://www.gestarsoft.com"
API_URL="https://www.gestarsoft.com"

# ─── Puppeteer / Chrome ───────────────────────────────────────────────────────
# Necesario para que puppeteer use el chromium instalado por nixpacks.
PUPPETEER_EXECUTABLE_PATH="/run/current-system/sw/bin/chromium"
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD="true"

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="app-password-de-gmail"
SMTP_FROM="GESTARCORP <noreply@gestarsoft.com>"

# ─── PayPal ───────────────────────────────────────────────────────────────────
# Obtener en: https://developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID="AXxx..."          # Client ID (también va en VITE_PAYPAL_CLIENT_ID)
PAYPAL_CLIENT_SECRET="EXxx..."      # Secret (solo backend, nunca al frontend)
PAYPAL_MODE="live"                  # "sandbox" para pruebas, "live" para producción

# Variable pública para el frontend (misma que PAYPAL_CLIENT_ID)
VITE_PAYPAL_CLIENT_ID="AXxx..."

# ─── Anthropic (opcional — IA para screening) ─────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Stripe (suscripciones — configurar cuando se active) ─────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MENSUAL="price_..."
STRIPE_PRICE_ANUAL="price_..."

# ─── Uploads ──────────────────────────────────────────────────────────────────
# En Railway: crear un Volume montado en /app/backend/uploads
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE="10485760"
